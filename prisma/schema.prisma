// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  DEVELOPER
  TRAFFIC_MANAGER
  VIEWER
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  SOLD
  UNAVAILABLE
}

enum PropertyType {
  HOUSE
  APARTMENT
  CONDO
  LAND
  COMMERCIAL
  FARM
}

enum PropertyPurpose {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyCategory {
  UNDER_CONSTRUCTION  // Na Planta
  READY               // Pronto
}

enum PropertyPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          UserRole  @default(VIEWER)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  properties    Property[]
  accounts      Account[]
  sessions      Session[]
  clients       Client[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Property {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  price       Decimal        @db.Decimal(12, 2)
  type        PropertyType
  status      PropertyStatus @default(AVAILABLE)
  
  // New fields for wizard
  purpose       PropertyPurpose       @default(RESIDENTIAL)
  category      PropertyCategory      @default(READY)
  publishStatus PropertyPublishStatus @default(DRAFT)
  
  // Location
  address     String
  number      String?       // Número do imóvel
  complement  String?       // Complemento
  neighborhood String?      // Bairro
  city        String
  state       String
  zipCode     String
  country     String         @default("Brasil")
  latitude    Float
  longitude   Float
  referencePoint String?     // Ponto de referência
  
  // Details
  bedrooms    Int?
  bathrooms   Int?
  area        Float?         // in square meters
  parkingSpots Int?
  
  // Features
  features    String[]       // Array of features like "Pool", "Garden", etc.
  
  // Media
  images      PropertyImage[]
  videoUrl    String?
  virtualTourUrl String?
  
  // Metadata
  featured    Boolean        @default(false)
  views       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  publishedAt DateTime?
  
  // Relations
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([status])
  @@index([type])
  @@index([city])
  @@index([featured])
  @@index([publishStatus])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  order      Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  
  @@index([propertyId])
}

// ==========================================
// MÓDULO DE CLIENTES
// ==========================================

enum PersonType {
  INDIVIDUAL  // Pessoa Física
  COMPANY     // Pessoa Jurídica
}

enum ContactType {
  PHONE
  EMAIL
  WHATSAPP
}

model Client {
  id           String      @id @default(cuid())
  personType   PersonType
  
  // Pessoa Física
  name         String?
  cpf          String?
  
  // Pessoa Jurídica
  companyName  String?     // Razão Social
  cnpj         String?
  
  notes        String?     @db.Text
  
  // Relations
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  representatives Representative[]
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  @@index([userId])
  @@index([personType])
}

model Contact {
  id        String      @id @default(cuid())
  type      ContactType
  value     String
  label     String?     // Ex: "Celular", "Comercial"
  isPrimary Boolean     @default(false)
  
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@index([clientId])
}

model Representative {
  id       String  @id @default(cuid())
  name     String
  role     String? // Ex: "Sócio", "Procurador"
  email    String?
  phone    String?
  
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  @@index([clientId])
}

